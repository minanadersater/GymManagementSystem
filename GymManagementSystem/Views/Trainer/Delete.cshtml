@model GymManagementSystem.BLL.ViewModels.TrainerViewModels.TrainerViewModel

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card p-5 shadow text-center">

                <i class="bi bi-exclamation-triangle text-warning display-4 mb-3"></i>

                <p class="fs-3 text-primary-color mb-4">
                    Are you sure you want to delete this Trainer?
                </p>

                <div class="alert alert-warning text-start" role="alert">
                    <strong>Warning!</strong>
                    This action cannot be undone.
                    All Trainer data will be permanently deleted.
                </div>

                <!-- Trainer Info Preview -->
                <div class="mb-4 text-start border rounded p-3">

                    <p class="mb-1">
                        <strong>Name:</strong> @Model.Name
                    </p>

                    <p class="mb-1">
                        <strong>Email:</strong> @Model.Email
                    </p>

                    <p class="mb-1">
                        <strong>Phone:</strong> @Model.Phone
                    </p>

                    <p class="mb-0">
                        <strong>Specialties:</strong> @Model.Specialties
                    </p>

                </div>

                <form asp-action="Delete"
                      asp-route-id="@Context.Request.RouteValues["id"]"
                      method="post"
                      class="mt-4">

                    <div class="buttons d-flex justify-content-between gap-3">

                        <a asp-controller="Trainer"
                           asp-action="Index"
                           class="btn-outline flex-fill">

                            NO

                        </a>

                        <button type="submit"
                                class="btn-fill flex-fill">

                            Yes, Delete

                        </button>

                    </div>

                </form>

            </div>

        </div>
    </div>
</div>